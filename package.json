{
  "name": "invoice-core",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first invoice editor with direct editing, live preview, downloadable A4 PDF, reusable company profiles, and offline support.",
  "license": "MIT",
  "homepage": "https://invoice.achmadya.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/achmadya-dev/invoice-core.git"
  },
  "bugs": {
    "url": "https://github.com/achmadya-dev/invoice-core/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite --host 127.0.0.1",
    "build": "bunx --bun vite build",
    "start": "bun .output/server/index.mjs",
    "typecheck": "tsc --noEmit && tsc6 --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs,ts}\" \"*.{js,mjs,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs,ts}\" \"*.{js,mjs,ts,json}\"",
    "lint": "eslint . --max-warnings=0",
    "lint:staged": "lint-staged",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:offline": "playwright test --config playwright.invoice.config.ts",
    "test:policy": "node --test scripts/*.test.mjs",
    "check": "bun run format:check && bun run lint && bun run test:policy && bun run test && bun run build && bun run typecheck",
    "verify": "bun run check && bun run test:e2e && bun run test:production && bun run test:offline",
    "prepare": "husky",
    "doctor": "bun scripts/doctor.mjs",
    "test:production": "bun scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@react-pdf/renderer": "4.9.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.15.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "nitro": "3.0.260903-beta",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.8",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json}": "prettier --write"
  },
  "packageManager": "bun@1.4.2"
}
